# ─────────────────────────────────────────────
# OmniUtility Backend — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Server port
PORT=3001

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Maximum video file size to stream (in MB) — safeguard against huge files
MAX_STREAM_SIZE_MB=2048

# Rate limiting — requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Optional: restrict downloads to YouTube only
# Set to "true" to block non-YouTube URLs
YOUTUBE_ONLY=false

# Optional: API key guard (leave empty to disable)
# If set, all requests must include: Authorization: Bearer <key>
API_KEY=

# yt-dlp binary path (leave empty to use system PATH)
YTDLP_PATH=yt-dlp

# FFmpeg binary path (leave empty to use system PATH)
FFMPEG_PATH=ffmpeg

# Temp directory for scratch files
TEMP_DIR=/tmp/ytdlp-scratch
